# ── 화학물질 데이터 출처 ───────────────────────────────────────────────
# live(기본): PubChem 실시간 조회(API 키 불필요). 한국어명은 data/name_map.json으로
#             CAS를 찾아 조회하고, 인터넷이 안 되면 샘플 6종으로 폴백
# sample    : data/substances.json 샘플 6종만 조회 — 인터넷 불필요
CHEM_DATA_MODE=live

# 공공데이터포털 API 키 (안전보건공단 MSDS — 확장 예정, 지금은 미사용)
# 실제 키는 .env에만 넣고 절대 커밋/공유하지 말 것
DATA_GO_KR_API_KEY=

# ── LangSmith 추적 (선택) — 쓰려면 true로 바꾸고 본인 키 입력 ─────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=chem-safety-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── LLM_BACKEND=openai(run_agent_openai.sh)에서만 필요 — 실제 과금 ───────
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
